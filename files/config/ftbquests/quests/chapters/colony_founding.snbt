	quests: [
		{
			dependencies: ["568A179A4BEAAA6B"]
			description: [
				"&eMineColonies&f lets you found a living town. Citizens move in, take jobs, build your blueprints and keep the place running while you are off adventuring."
				""
				"Every player may found (or join) &aone colony&f. Playing with friends? One of you places the Town Hall, then adds the others as &eOfficers&f in the Town Hall's &bPermissions&f tab so you all share it."
				"{@pagebreak}"
				"Your reward here is a &6Supply Camp&f and a &6Build Tool&f. Prefer the coast? Craft a &6Supply Ship&f instead - it needs open water."
				""
				"&cPick your spot carefully!&f Flat land, away from other colonies and from big dungeons, with trees and stone nearby."
			]
			hide_until_deps_complete: true
			id: "0D75A0087DFCFCA4"
			rewards: [
				{
					id: "4D476A66256CD631"
					item: "minecolonies:supplycampdeployer"
